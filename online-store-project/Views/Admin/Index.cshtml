@{
    ViewData["Title"] = "Admin Actions Center";
}

<section class="admin-page section-padding">
    <div class="container">

        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="fw-bold display-5 mb-2">Admin Actions Center</h1>
            <p class="text-muted mx-auto" style="max-width: 520px;">
                Quickly manage products, files, customers, orders and queue messages from one place.
            </p>
        </div>

        <!-- Action Cards - better balanced layout -->
        <div class="row g-4 justify-content-center">

            <!-- Products -->
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Products" asp-action="Index" class="admin-card text-decoration-none">
                    <div class="admin-card-icon products">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                    <h5 class="admin-card-title">Products</h5>
                    <p class="admin-card-desc">Manage product catalogue</p>
                </a>
            </div>

            <!-- Product Files -->
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="ProductFiles" asp-action="Index" class="admin-card text-decoration-none">
                    <div class="admin-card-icon files">
                        <i class="bi bi-folder-fill"></i>
                    </div>
                    <h5 class="admin-card-title">Product Files</h5>
                    <p class="admin-card-desc">Upload & download files</p>
                </a>
            </div>

            <!-- Customers -->
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Customers" asp-action="Index" class="admin-card text-decoration-none">
                    <div class="admin-card-icon customers">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5 class="admin-card-title">Customers</h5>
                    <p class="admin-card-desc">View & manage users</p>
                </a>
            </div>

            <!-- Orders -->
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Orders" asp-action="Index" class="admin-card text-decoration-none">
                    <div class="admin-card-icon orders">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <h5 class="admin-card-title">Orders</h5>
                    <p class="admin-card-desc">Track & process orders</p>
                </a>
            </div>

            <!-- Queue Messages -->
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Queues" asp-action="Index" class="admin-card text-decoration-none">
                    <div class="admin-card-icon queues">
                        <i class="bi bi-chat-dots-fill"></i>
                    </div>
                    <h5 class="admin-card-title">Queue Messages</h5>
                    <p class="admin-card-desc">View & process messages</p>
                </a>
            </div>

        </div>

    </div>
</section>