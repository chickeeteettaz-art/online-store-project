@model online_store_project.Models.CustomerEntity
@{
    ViewData["Title"] = "Add Customer";
}

<section class="form-page section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">

                <!-- Header -->
                <div class="mb-4">
                    <a asp-action="Index" class="btn btn-back mb-3">
                        <i class="bi bi-arrow-left me-2"></i> Back to Customers
                    </a>
                    <h1 class="fw-bold display-6 mb-1">Add New Customer</h1>
                    <p class="text-muted">Fill in the details below to create a customer profile.</p>
                </div>

                <!-- Form Card -->
                <div class="card form-card">
                    <div class="card-body p-4 p-md-5">

                        <form asp-action="Create" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                            <!-- Profile Photo -->
                            <div class="mb-4 text-center">
                                <div class="profile-photo-preview mb-3" id="photoPreview">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <label class="form-label fw-semibold">Profile Photo</label>
                                <input type="file"
                                       name="ProfilePhoto"
                                       id="ProfilePhoto"
                                       class="form-control form-control-modern"
                                       accept="image/*"
                                       onchange="previewPhoto(event)" />
                                <div class="form-text">Optional. JPG, PNG or WEBP recommended.</div>
                            </div>

                            <div class="row g-3">
                                <!-- First Name -->
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label fw-semibold">First Name</label>
                                    <input asp-for="FirstName" class="form-control form-control-modern" placeholder="e.g. John" />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>

                                <!-- Last Name -->
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label fw-semibold">Last Name</label>
                                    <input asp-for="LastName" class="form-control form-control-modern" placeholder="e.g. Doe" />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>

                                <!-- Email -->
                                <div class="col-12">
                                    <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                                    <input asp-for="Email" type="email" class="form-control form-control-modern" placeholder="john@example.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <!-- Phone Number -->
                                <div class="col-12">
                                    <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control form-control-modern" placeholder="e.g. 082 123 4567" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="d-flex flex-wrap gap-3 mt-5">
                                <button type="submit" class="btn btn-primary-custom text-white rounded-pill px-5">
                                    <i class="bi bi-check-lg me-2"></i> Create Customer
                                </button>
                                <a asp-action="UserLogin" class="btn btn-outline-secondary rounded-pill px-4">
                                    Cancel
                                </a>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewPhoto(event) {
            const input = event.target;
            const preview = document.getElementById('photoPreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.innerHTML = `<img src="${e.target.result}" alt="Preview" />`;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}