@{
    ViewData["Title"] = "Login";
}

<section class="login-page">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-6 col-lg-5 col-xl-4">

                <div class="card login-card">
                    <div class="card-body p-4 p-md-5">

                        <!-- Brand / Header -->
                        <div class="text-center mb-4">
                            <div class="login-icon mb-3">
                                <i class="bi bi-bag-heart-fill"></i>
                            </div>
                            <h1 class="fw-bold h3 mb-1">Welcome back</h1>
                            <p class="text-muted small mb-0">Sign in with your email and first name</p>
                        </div>

                        <!-- Error message from Authenticate -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger rounded-3 small mb-4"
                             role="alert">
                        </div>

                        <!-- Login Form -->
                        <form asp-controller="Authentication" asp-action="Authenticate" method="post">

                            <div class="mb-3">
                                <label for="email" class="form-label fw-semibold">Email Address</label>
                                <input type="email"
                                       name="email"
                                       id="email"
                                       class="form-control form-control-modern"
                                       placeholder="you@example.com"
                                       required
                                       autofocus />
                            </div>

                            <div class="mb-4">
                                <label for="firstName" class="form-label fw-semibold">First Name</label>
                                <input type="text"
                                       name="firstName"
                                       id="firstName"
                                       class="form-control form-control-modern"
                                       placeholder="e.g. John"
                                       required />
                            </div>

                            <button type="submit" class="btn btn-primary-custom text-white w-100 rounded-pill py-2 fw-semibold">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Sign In
                            </button>
                        </form>

                        <!-- Footer links -->
                        <div class="text-center mt-4 pt-3 border-top">
                            <p class="small text-muted mb-0">
                                Don’t have an account?
                                <a asp-controller="Authentication" asp-action="Signup" class="fw-semibold text-decoration-none">
                                    Create one
                                </a>
                            </p>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>