@model online_store_project.Models.OrderEntity
@{
    ViewData["Title"] = "Delete Order";
    var shortId = Model?.RowKey?.Length >= 8 ? Model.RowKey[..8] : Model?.RowKey;
}

<section class="form-page section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-xl-6">

                <!-- Header -->
                <div class="mb-4">
                    <a asp-action="Index" class="btn btn-back mb-3">
                        <i class="bi bi-arrow-left me-2"></i> Back to Orders
                    </a>
                    <h1 class="fw-bold display-6 mb-1 text-danger">Delete Order</h1>
                    <p class="text-muted">Are you sure you want to permanently delete this order?</p>
                </div>

                @if (Model == null)
                {
                    <div class="alert alert-warning rounded-3">
                        Order not found.
                    </div>
                }
                else
                {
                    <!-- Confirmation Card -->
                    <div class="card form-card border-danger border-opacity-25">
                        <div class="card-body p-4 p-md-5">

                            <div class="text-center mb-4">
                                <div class="delete-icon mb-3">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                </div>
                                <h4 class="fw-bold">Order #@shortId</h4>
                                <p class="text-muted small mb-0">This action cannot be undone.</p>
                            </div>

                            <!-- Order Summary -->
                            <div class="bg-light rounded-3 p-3 mb-4">
                                <div class="row g-2 small">
                                    <div class="col-5 text-muted">Customer ID</div>
                                    <div class="col-7 fw-medium">
                                        <code>@(Model.CustomerId ?? "—")</code>
                                    </div>

                                    <div class="col-5 text-muted">Product ID</div>
                                    <div class="col-7 fw-medium">
                                        <code>@(Model.ProductId ?? "—")</code>
                                    </div>

                                    <div class="col-5 text-muted">Order Date</div>
                                    <div class="col-7 fw-medium">
                                        @Model.OrderDate.ToString("dd MMM yyyy HH:mm")
                                    </div>

                                    <div class="col-5 text-muted">Quantity</div>
                                    <div class="col-7 fw-medium">@Model.Quantity</div>

                                    <div class="col-5 text-muted">Total Price</div>
                                    <div class="col-7 fw-medium text-primary">R @Model.TotalPrice</div>

                                    <div class="col-5 text-muted">Status</div>
                                    <div class="col-7 fw-medium">@(Model.Status ?? "Pending")</div>
                                </div>
                            </div>

                            <!-- Actions -->
                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="PartitionKey" />
                                <input type="hidden" asp-for="RowKey" />

                                <div class="d-flex flex-wrap gap-3">
                                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                                        <i class="bi bi-trash me-2"></i> Yes, Delete Order
                                    </button>
                                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                        Cancel
                                    </a>
                                </div>
                            </form>

                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</section>