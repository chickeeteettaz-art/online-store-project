@model online_store_project.Models.OrderEntity
@{
    ViewData["Title"] = "Order Details";
    var shortId = Model?.RowKey?.Length >= 8 ? Model.RowKey[..8] : Model?.RowKey;
}

<section class="order-details-page section-padding">
    <div class="container">

        <!-- Back Button -->
        <div class="mb-4">
            <a asp-action="Index" class="btn btn-back">
                <i class="bi bi-arrow-left me-2"></i> Back to Orders
            </a>
        </div>

        @if (Model == null)
        {
            <div class="text-center py-5">
                <i class="bi bi-exclamation-circle display-4 text-muted mb-3 d-block"></i>
                <h3 class="fw-semibold">Order not found</h3>
                <p class="text-muted">The order you are looking for does not exist or has been removed.</p>
                <a asp-action="Index" class="btn btn-primary-custom text-white rounded-pill px-4 mt-3">
                    Back to Orders
                </a>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                <div class="col-lg-9">

                    <div class="card customer-detail-card">
                        <div class="card-body p-4 p-md-5">

                            <!-- Header -->
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
                                <div>
                                    <h1 class="fw-bold mb-1">Order #@shortId</h1>
                                    <p class="text-muted mb-0">
                                        Placed on @Model.OrderDate.ToString("dd MMMM yyyy, HH:mm")
                                    </p>
                                </div>

                                @{
                                    var status = Model.Status ?? "Pending";
                                    var badgeClass = status.ToLower() switch
                                    {
                                        "completed" or "delivered" => "bg-success",
                                        "processing" or "shipped" => "bg-primary",
                                        "cancelled" => "bg-danger",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge rounded-pill fs-6 px-3 py-2 @badgeClass">
                                    @status
                                </span>
                            </div>

                            <!-- Details Grid -->
                            <div class="row g-4">

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="bi bi-person"></i> Customer ID
                                        </div>
                                        <div class="detail-value">
                                            <code>@(Model.CustomerId ?? "—")</code>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="bi bi-box-seam"></i> Product ID
                                        </div>
                                        <div class="detail-value">
                                            <code>@(Model.ProductId ?? "—")</code>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="bi bi-calendar3"></i> Order Date
                                        </div>
                                        <div class="detail-value">
                                            @Model.OrderDate.ToString("dddd, dd MMM yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="bi bi-hash"></i> Quantity
                                        </div>
                                        <div class="detail-value">
                                            @Model.Quantity
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="bi bi-currency-exchange"></i> Total Price
                                        </div>
                                        <div class="detail-value fw-bold text-primary fs-5">
                                            R @Model.TotalPrice
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="bi bi-info-circle"></i> Status
                                        </div>
                                        <div class="detail-value">
                                            @status
                                        </div>
                                    </div>
                                </div>

                                <!-- Technical Keys -->
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="bi bi-key"></i> Partition Key
                                        </div>
                                        <div class="detail-value">
                                            <code class="small">@Model.PartitionKey</code>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="bi bi-key"></i> Row Key
                                        </div>
                                        <div class="detail-value">
                                            <code class="small text-break">@Model.RowKey</code>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex flex-wrap gap-3 mt-5 pt-4 border-top">
                                <a asp-action="Edit"
                                   asp-route-partitionKey="@Model.PartitionKey"
                                   asp-route-rowKey="@Model.RowKey"
                                   class="btn btn-primary-custom text-white rounded-pill px-4">
                                    <i class="bi bi-pencil me-2"></i> Edit Order
                                </a>

                                <form asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this order? This action cannot be undone.');">
                                    <input type="hidden" name="partitionKey" value="@Model.PartitionKey" />
                                    <input type="hidden" name="rowKey" value="@Model.RowKey" />
                                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                                        <i class="bi bi-trash me-2"></i> Delete
                                    </button>
                                </form>

                                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                    Back to List
                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</section>