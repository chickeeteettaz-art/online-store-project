@model IEnumerable<online_store_project.Models.OrderEntity>
@{
    ViewData["Title"] = "Orders";
}

<section class="orders-page section-padding">
    <div class="container">

        <!-- Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
            <div>
                <h1 class="fw-bold display-6 mb-2">Orders</h1>
                <p class="text-muted mb-0">View and manage customer orders.</p>
            </div>
            
        </div>

        <!-- Orders Table -->
        <div class="card customers-table-card">
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 customers-table">
                            <thead>
                                <tr>
                                    <th class="ps-4">Order</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var userFirstName = Context.Session.GetString("UserFirstName");
                                    var isLoggedIn = !string.IsNullOrEmpty(userFirstName);
                                }
                                @foreach (var order in Model)
                                {
                                    if (userFirstName == "Admin" || (isLoggedIn && order.CustomerId == userFirstName))
                                    {
                                        <tr>
                                            <!-- Order ID -->
                                            <td class="ps-4">
                                                <div class="fw-semibold">
                                                    #@(order.RowKey?.Length >= 8 ? order.RowKey[..8] : order.RowKey)
                                                </div>
                                                <div class="small text-muted">
                                                    PK: @order.PartitionKey
                                                </div>
                                            </td>

                                            <!-- Customer -->
                                            <td>
                                                <div class="small">
                                                    @if (!string.IsNullOrEmpty(order.CustomerId))
                                                    {
                                                        <div>
                                                            <i class="bi bi-envelope me-1 text-muted"></i>
                                                            @order.CustomerId
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(order.CustomerId))
                                                    {
                                                        <div class="text-muted">
                                                            @order.CustomerId
                                                        </div>
                                                    }
                                                </div>
                                            </td>

                                            <!-- Date -->
                                            <td>
                                                <span class="small">
                                                    @(
                                                         order.OrderDate.ToString("dd MMM yyyy")
                                                        )
                                                </span>
                                            </td>

                                            <!-- Total -->
                                            <td>
                                                <span class="fw-semibold text-primary">
                                                    R @(order.TotalPrice.ToString("F2"))
                                                </span>
                                            </td>

                                            <!-- Status -->
                                            <td>
                                                @{
                                                    var status = order.Status ?? "Pending";
                                                    var badgeClass = status.ToLower() switch
                                                    {
                                                        "completed" or "delivered" => "bg-success",
                                                        "processing" or "shipped" => "bg-primary",
                                                        "cancelled" => "bg-danger",
                                                        _ => "bg-warning text-dark"
                                                    };
                                                }
                                                <span class="badge rounded-pill @badgeClass">
                                                    @status
                                                </span>
                                            </td>

                                            <!-- Actions -->
                                            <td class="text-end pe-4">
                                                <div class="d-flex justify-content-end gap-2">
                                                    <a asp-action="Details"
                                                       asp-route-partitionKey="@order.PartitionKey"
                                                       asp-route-rowKey="@order.RowKey"
                                                       class="btn btn-sm btn-action"
                                                       title="View details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>

                                                    <a asp-action="Edit"
                                                       asp-route-partitionKey="@order.PartitionKey"
                                                       asp-route-rowKey="@order.RowKey"
                                                       class="btn btn-sm btn-action"
                                                       title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>

                                                    <form asp-action="Delete" method="post" class="d-inline"
                                                          onsubmit="return confirm('Are you sure you want to delete this order?');">
                                                        <input type="hidden" name="partitionKey" value="@order.PartitionKey" />
                                                        <input type="hidden" name="rowKey" value="@order.RowKey" />
                                                        <button type="submit" class="btn btn-sm btn-action text-danger" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }else if(userFirstName == order.CustomerId)
                                    {
                                        <tr>
                                            <!-- Order ID -->
                                            <td class="ps-4">
                                                <div class="fw-semibold">
                                                    #@(order.RowKey?.Length >= 8 ? order.RowKey[..8] : order.RowKey)
                                                </div>
                                                <div class="small text-muted">
                                                    PK: @order.PartitionKey
                                                </div>
                                            </td>

                                            <!-- Customer -->
                                            <td>
                                                <div class="small">
                                                    @if (!string.IsNullOrEmpty(order.CustomerId))
                                                    {
                                                        <div>
                                                            <i class="bi bi-envelope me-1 text-muted"></i>
                                                            @order.CustomerId
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(order.CustomerId))
                                                    {
                                                        <div class="text-muted">
                                                            @order.CustomerId
                                                        </div>
                                                    }
                                                </div>
                                            </td>

                                            <!-- Date -->
                                            <td>
                                                <span class="small">
                                                    @(
                                                         order.OrderDate.ToString("dd MMM yyyy")
                                                        )
                                                </span>
                                            </td>

                                            <!-- Total -->
                                            <td>
                                                <span class="fw-semibold text-primary">
                                                    R @(order.TotalPrice.ToString("F2"))
                                                </span>
                                            </td>

                                            <!-- Status -->
                                            <td>
                                                @{
                                                    var status = order.Status ?? "Pending";
                                                    var badgeClass = status.ToLower() switch
                                                    {
                                                        "completed" or "delivered" => "bg-success",
                                                        "processing" or "shipped" => "bg-primary",
                                                        "cancelled" => "bg-danger",
                                                        _ => "bg-warning text-dark"
                                                    };
                                                }
                                                <span class="badge rounded-pill @badgeClass">
                                                    @status
                                                </span>
                                            </td>

                                            <!-- Actions -->
                                            <td class="text-end pe-4">
                                                <div class="d-flex justify-content-end gap-2">
                                                    <a asp-action="Details"
                                                       asp-route-partitionKey="@order.PartitionKey"
                                                       asp-route-rowKey="@order.RowKey"
                                                       class="btn btn-sm btn-action"
                                                       title="View details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>

                                                    <a asp-action="Edit"
                                                       asp-route-partitionKey="@order.PartitionKey"
                                                       asp-route-rowKey="@order.RowKey"
                                                       class="btn btn-sm btn-action"
                                                       title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>

                                                    <form asp-action="Delete" method="post" class="d-inline"
                                                          onsubmit="return confirm('Are you sure you want to delete this order?');">
                                                        <input type="hidden" name="partitionKey" value="@order.PartitionKey" />
                                                        <input type="hidden" name="rowKey" value="@order.RowKey" />
                                                        <button type="submit" class="btn btn-sm btn-action text-danger" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-receipt display-4 text-muted mb-3 d-block"></i>
                        <h4 class="fw-semibold">No orders yet</h4>
                        <p class="text-muted mb-4">Orders will appear here once customers place them.</p>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-primary-custom text-white rounded-pill px-4">
                            <i class="bi bi-plus-lg me-1"></i> Start Shopping
                        </a>
                    </div>
                }
            </div>
        </div>

    </div>
</section>