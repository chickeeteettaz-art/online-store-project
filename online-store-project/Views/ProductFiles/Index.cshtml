@model IEnumerable<online_store_project.Models.ProductFile>

@{
    ViewData["Title"] = "Product Files";
}

<section class="files-page section-padding">
    <div class="container">

        <!-- Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
            <div>
                <h1 class="fw-bold display-6 mb-2">Log Files</h1>
                <p class="text-muted mb-0">
                    Manage files stored in Azure File Share.
                </p>
            </div>

            <div>
                <a asp-action="Upload"
                   class="btn btn-primary-custom text-white rounded-pill px-4">
                    <i class="bi bi-cloud-upload me-1"></i>
                    Upload File
                </a>
            </div>
        </div>

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4"
                 role="alert">
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <!-- Error Message -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4"
                 role="alert">
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <!-- Files Table -->
        @if (Model != null && Model.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3">
                                        #
                                    </th>

                                    <th class="py-3">
                                        File Name
                                    </th>

                                    <th class="py-3">
                                        File Size
                                    </th>

                                    <th class="py-3 text-end px-4">
                                        Actions
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    var counter = 1;
                                }

                                @foreach (var file in Model)
                                {
                                    var iconClass = GetFileIcon(file.FileName);
                                    var colorClass = GetFileColor(file.FileName);
                                    var extension = System.IO.Path
                                        .GetExtension(file.FileName)?
                                        .ToUpperInvariant()
                                        .TrimStart('.');

                                    <tr>

                                        <!-- Number -->
                                        <td class="px-4 text-muted">
                                            @counter
                                        </td>

                                        <!-- File Name -->
                                        <td>
                                            <div class="d-flex align-items-center gap-3">

                                                <div class="file-table-icon @colorClass">
                                                    <i class="bi @iconClass"></i>
                                                </div>

                                                <div>
                                                    <div class="fw-semibold text-dark">
                                                        @file.FileName
                                                    </div>

                                                    <small class="text-muted">
                                                        Product File
                                                    </small>
                                                </div>

                                            </div>
                                        </td>

                                        <!-- File Size -->
                                        <td>
                                            <span class="text-muted">
                                                @FormatFileSize(file.FileSize)
                                            </span>
                                        </td>

                                        <!-- Actions -->
                                        <td class="text-end px-4">

                                            <a asp-action="Download"
                                               asp-route-fileName="@file.FileName"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3">

                                                <i class="bi bi-download me-1"></i>
                                                Download

                                            </a>

                                        </td>

                                    </tr>

                                    counter++;
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center py-5">

                <i class="bi bi-folder2-open display-4 text-muted mb-3 d-block"></i>

                <h4 class="fw-semibold">
                    No files uploaded yet
                </h4>

                <p class="text-muted mb-4">
                    Upload product-related documents, images or other files.
                </p>

                <a asp-action="Upload"
                   class="btn btn-primary-custom text-white rounded-pill px-4">

                    <i class="bi bi-cloud-upload me-1"></i>
                    Upload File

                </a>

            </div>
        }

    </div>
</section>


@functions {

    string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:F1} KB";

        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }


    string GetFileIcon(string fileName)
    {
        var ext = System.IO.Path
            .GetExtension(fileName)?
            .ToLowerInvariant();

        return ext switch
        {
            ".pdf" => "bi-file-earmark-pdf-fill",

            ".doc" or ".docx" =>
                "bi-file-earmark-word-fill",

            ".xls" or ".xlsx" =>
                "bi-file-earmark-excel-fill",

            ".ppt" or ".pptx" =>
                "bi-file-earmark-ppt-fill",

            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp" =>
                "bi-file-earmark-image-fill",

            ".txt" or ".csv" or ".log" =>
                "bi-file-earmark-text-fill",

            ".zip" or ".rar" or ".7z" =>
                "bi-file-earmark-zip-fill",

            ".mp4" or ".mov" or ".avi" or ".mkv" =>
                "bi-file-earmark-play-fill",

            ".mp3" or ".wav" or ".flac" =>
                "bi-file-earmark-music-fill",

            _ => "bi-file-earmark-fill"
        };
    }


    string GetFileColor(string fileName)
    {
        var ext = System.IO.Path
            .GetExtension(fileName)?
            .ToLowerInvariant();

        return ext switch
        {
            ".pdf" => "icon-pdf",

            ".doc" or ".docx" =>
                "icon-word",

            ".xls" or ".xlsx" =>
                "icon-excel",

            ".ppt" or ".pptx" =>
                "icon-ppt",

            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp" =>
                "icon-image",

            ".txt" or ".csv" or ".log" =>
                "icon-text",

            ".zip" or ".rar" or ".7z" =>
                "icon-zip",

            ".mp4" or ".mov" or ".avi" or ".mkv" =>
                "icon-video",

            ".mp3" or ".wav" or ".flac" =>
                "icon-audio",

            _ => "icon-default"
        };
    }
}