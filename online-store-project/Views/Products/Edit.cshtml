@model online_store_project.Models.ProductEntity

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Edit Product</h1>
            <p class="text-muted mb-0">Update the product details below</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">

                    <!-- Note: posts to Update action -->
                    <form action="@Url.Action("Update")" method="post" enctype="multipart/form-data">

                        <!-- Hidden fields required by Azure Table -->
                        <input type="hidden" asp-for="PartitionKey" />
                        <input type="hidden" asp-for="RowKey" />
                        <input type="hidden" asp-for="ETag" />
                        <input type="hidden" asp-for="Timestamp" />
                        <input type="hidden" asp-for="ProductImageUrl" id="CurrentImageUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-4">

                            <!-- Left Column: Image -->
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">
                                    Product Image
                                </label>

                                <!-- Preview Box -->
                                <div id="imagePreviewContainer"
                                     class="border rounded-3 bg-light d-flex align-items-center justify-content-center mb-3"
                                     style="height: 260px; overflow: hidden; position: relative;">

                                    @if (!string.IsNullOrEmpty(Model.ProductImageUrl))
                                    {
                                        <img id="imagePreview"
                                             src="@Model.ProductImageUrl"
                                             alt="Current product image"
                                             class="w-100 h-100"
                                             style="object-fit: cover;" />
                                        <div id="placeholder" class="d-none text-center text-muted p-3">
                                            <i class="bi bi-image display-4 d-block mb-2"></i>
                                            <span class="small">Image preview will appear here</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="placeholder" class="text-center text-muted p-3">
                                            <i class="bi bi-image display-4 d-block mb-2"></i>
                                            <span class="small">No image uploaded yet</span>
                                        </div>
                                        <img id="imagePreview" src="#" alt="Preview"
                                             class="d-none w-100 h-100"
                                             style="object-fit: cover;" />
                                    }
                                </div>

                                <!-- File Input -->
                                <div class="mb-2">
                                    <input type="file"
                                           name="ProductImage"
                                           id="ProductImage"
                                           class="form-control"
                                           accept="image/*"
                                           onchange="previewImage(event)" />
                                </div>
                                <div class="form-text">
                                    Leave empty to keep the current image. Supported: JPG, PNG, WEBP
                                </div>
                            </div>

                            <!-- Right Column: Details -->
                            <div class="col-md-7">

                                <!-- Product Name -->
                                <div class="mb-3">
                                    <label asp-for="ProductName" class="form-label fw-semibold">
                                        Product Name <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="ProductName" class="form-control form-control-lg"
                                           placeholder="e.g. Wireless Bluetooth Headphones" />
                                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                                </div>

                                <!-- Description -->
                                <div class="mb-3">
                                    <label asp-for="ProductDescription" class="form-label fw-semibold">
                                        Description
                                    </label>
                                    <textarea asp-for="ProductDescription" class="form-control" rows="4"
                                              placeholder="Describe the product features, benefits, and details..."></textarea>
                                    <span asp-validation-for="ProductDescription" class="text-danger small"></span>
                                </div>

                                <!-- Price & Stock -->
                                <div class="row g-3 mb-3">
                                    <div class="col-sm-6">
                                        <label asp-for="ProductPrice" class="form-label fw-semibold">
                                            Price (R) <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light">R</span>
                                            <input asp-for="ProductPrice" class="form-control"
                                                   type="number" step="0.01" min="0" placeholder="0.00" />
                                        </div>
                                        <span asp-validation-for="ProductPrice" class="text-danger small"></span>
                                    </div>

                                    <div class="col-sm-6">
                                        <label asp-for="StockQuantity" class="form-label fw-semibold">
                                            Stock Quantity <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="StockQuantity" class="form-control"
                                               type="number" min="0" placeholder="0" />
                                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                                    </div>
                                </div>

                                <!-- Optional Quantity -->
                                <div class="mb-3">
                                    <label asp-for="ProductQuantity" class="form-label fw-semibold">
                                        Product Quantity (optional)
                                    </label>
                                    <input asp-for="ProductQuantity" class="form-control"
                                           type="number" step="0.01" min="0" placeholder="0" />
                                    <span asp-validation-for="ProductQuantity" class="text-danger small"></span>
                                </div>

                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex flex-column flex-sm-row gap-2 pt-4 mt-2 border-top">
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewImage(event) {
            const input = event.target;
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('placeholder');

            if (input.files && input.files[0]) {
                const reader = new FileReader();

                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    if (placeholder) {
                        placeholder.classList.add('d-none');
                    }
                };

                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}