@model IEnumerable<online_store_project.Models.QueueMessage>

@{
    ViewData["Title"] = "Queue Messages";
}

<section class="queue-page section-padding">
    <div class="container">

        <!-- Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">

            <div>
                <h1 class="fw-bold display-6 mb-2">
                    Queue Messages
                </h1>

                <p class="text-muted mb-0">
                    View messages currently waiting in Azure Queue Storage.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">

                <a asp-action="Send"
                   class="btn btn-primary-custom text-white rounded-pill px-4">

                    <i class="bi bi-plus-lg me-1"></i>
                    Send Message

                </a>

                <form asp-action="SendTestMessage"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-secondary rounded-pill px-3">

                        <i class="bi bi-lightning me-1"></i>
                        Send Test

                    </button>

                </form>

            </div>

        </div>


        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4"
                 role="alert">

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- Error Message -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4"
                 role="alert">

                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- Queue Messages Table -->
        @if (Model != null && Model.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th class="px-4 py-3">
                                        #
                                    </th>

                                    <th class="py-3">
                                        Type
                                    </th>

                                    <th class="py-3">
                                        Order ID
                                    </th>

                                    <th class="py-3">
                                        Customer
                                    </th>

                                    <th class="py-3">
                                        Product
                                    </th>

                                    <th class="py-3 text-center">
                                        Quantity
                                    </th>

                                    <th class="py-3">
                                        Total
                                    </th>

                                    
                                </tr>

                            </thead>

                            <tbody>

                                @{
                                    var counter = 1;
                                }

                                @foreach (var msg in Model)
                                {
                                    <tr>

                                        <!-- Number -->
                                        <td class="px-4 text-muted">
                                            @counter
                                        </td>


                                        <!-- Type -->
                                        <td>

                                            <span class="badge rounded-pill bg-primary">

                                                @(msg.Type ?? "Unknown")

                                            </span>

                                        </td>


                                        <!-- Order ID -->
                                        <td>

                                            <span class="fw-semibold">
                                                @(msg.OrderId ?? "—")
                                            </span>

                                        </td>


                                        <!-- Customer -->
                                        <td>

                                            <span class="queue-table-text"
                                                  title="@msg.CustomerId">

                                                @(msg.CustomerId ?? "—")

                                            </span>

                                        </td>


                                        <!-- Product -->
                                        <td>

                                            <span class="queue-table-text"
                                                  title="@msg.ProductId">

                                                @(msg.ProductId ?? "—")

                                            </span>

                                        </td>


                                        <!-- Quantity -->
                                        <td class="text-center">

                                            <span class="badge bg-light text-dark border">

                                                @msg.Quantity

                                            </span>

                                        </td>


                                        <!-- Total -->
                                        <td>

                                            <span class="fw-semibold text-primary">

                                                R @msg.TotalPrice

                                            </span>

                                        </td>

                                        

                                    </tr>

                                    counter++;
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- Additional Information -->
            @if (Model.Any(m => !string.IsNullOrEmpty(m.AdditionalInfo)))
            {
                <div class="mt-4">

                    <h6 class="fw-semibold mb-3">
                        Additional Information
                    </h6>

                    <div class="card border-0 shadow-sm rounded-4">

                        <div class="card-body">

                            @foreach (var msg in Model.Where(m => !string.IsNullOrEmpty(m.AdditionalInfo)))
                            {
                                <div class="border-bottom py-2">

                                    <div class="small text-muted">
                                        Message: @msg.MessageId
                                    </div>

                                    <div>
                                        @msg.AdditionalInfo
                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <!-- Empty State -->

            <div class="text-center py-5">

                <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>

                <h4 class="fw-semibold">
                    Queue is empty
                </h4>

                <p class="text-muted mb-4">
                    There are currently no messages in the queue.
                </p>

                <a asp-action="Send"
                   class="btn btn-primary-custom text-white rounded-pill px-4">

                    <i class="bi bi-plus-lg me-1"></i>
                    Send a Message

                </a>

            </div>
        }

    </div>
</section>